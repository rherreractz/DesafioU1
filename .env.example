import mysql from 'mysql2/promise';

// 1. Conexión a la base de datos (Site4Now)
const pool = mysql.createPool({
  host: process.env.DB_HOST || 'mysql8001.site4now.net',
  port: Number(process.env.DB_PORT) || 3306,
  user: process.env.DB_USER || 'a34a77_torneovideojuegos',
  password: process.env.DB_PASSWORD || 'Qwer1234@',
  database: process.env.DB_NAME || 'db_a34a77_torneovideojuegos',
  waitForConnections: true,
  connectionLimit: 10,
  queueLimit: 0,
  ssl: {
    rejectUnauthorized: false
  }
});

// ==========================================
// FUNCIONES DE CONSULTA (READ)
// ==========================================

// 1. Consultar todos los jugadores
export async function obtenerJugadores() {
  const [rows] = await pool.query('SELECT id, nombre, gamertag, email, fecha_registro FROM jugadores');
  return rows;
}

// 2. Consultar todos los videojuegos
export async function obtenerVideojuegos() {
  const [rows] = await pool.query('SELECT id, nombre, genero FROM videojuegos');
  return rows;
}

// 3. Consultar todos los puntajes
export async function obtenerPuntajes() {
  const [rows] = await pool.query('SELECT * FROM puntuaciones');
  return rows;
}

// 4. Buscar jugador por Nombre o Gamertag
export async function buscarJugador(busqueda) {
  const query = `
    SELECT id, nombre, gamertag, email, fecha_registro 
    FROM jugadores 
    WHERE nombre LIKE CONCAT('%', ?, '%') OR gamertag LIKE CONCAT('%', ?, '%')
  `;
  const [rows] = await pool.query(query, [busqueda, busqueda]);
  return rows;
}

// 5. Consultar Clasificación / Ranking
export async function obtenerRanking() {
  const query = `
    SELECT 
      RANK() OVER (ORDER BY p.puntuacion DESC) AS posicion,
      j.gamertag AS jugador,
      v.nombre AS videojuego,
      p.puntuacion
    FROM puntuaciones p
    INNER JOIN jugadores j ON p.jugador_id = j.id
    INNER JOIN videojuegos v ON p.videojuego_id = v.id
    ORDER BY p.puntuacion DESC
  `;
  const [rows] = await pool.query(query);
  return rows;
}

// 6. Consultar Estadísticas Generales
export async function obtenerEstadisticas() {
  const query = `
    SELECT 
      (SELECT COUNT(*) FROM jugadores) AS total_jugadores,
      (SELECT COUNT(*) FROM videojuegos) AS total_videojuegos,
      (SELECT COUNT(*) FROM puntuaciones) AS total_puntuaciones,
      (SELECT COALESCE(AVG(puntuacion), 0) FROM puntuaciones) AS puntuacion_promedio
  `;
  const [rows] = await pool.query(query);
  return rows[0];
}

// ==========================================
// FUNCIONES DE REGISTRO (CREATE)
// ==========================================

// Registrar Jugador
export async function registrarJugador(nombre, gamertag, email) {
  const query = 'INSERT INTO jugadores (nombre, gamertag, email) VALUES (?, ?, ?)';
  const [result] = await pool.query(query, [nombre, gamertag, email]);
  return result;
}

// Registrar Videojuego
export async function registrarVideojuego(nombre, genero) {
  const query = 'INSERT INTO videojuegos (nombre, genero) VALUES (?, ?)';
  const [result] = await pool.query(query, [nombre, genero]);
  return result;
}

// Registrar Puntuación
export async function registrarPuntuacion(jugador_id, videojuego_id, puntuacion) {
  const query = 'INSERT INTO puntuaciones (jugador_id, videojuego_id, puntuacion) VALUES (?, ?, ?)';
  const [result] = await pool.query(query, [jugador_id, videojuego_id, puntuacion]);
  return result;
}

export default pool;